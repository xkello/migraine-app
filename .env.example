# .env.example — copy to .env and fill in your values
#
# Fresh start:
#   cp .env.example .env      # then edit the values below
#   docker compose up --build
#   open http://localhost:8000/sk/

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=migraine_db
DB_USER=migraine_user
DB_PASSWORD=migraine_local_pw       # change this

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-local-dev-key-change-in-production
DEBUG=True
# Comma-separated extra hostnames (leave empty for localhost only)
DJANGO_ALLOWED_HOSTS=

# ── OpenWeatherMap API ────────────────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# ── Initial admin account (auto-created on first boot, skipped if exists) ─────
# Uncomment and fill in to skip the manual `createsuperuser` step.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=changeme
# DJANGO_SUPERUSER_EMAIL=admin@example.com
